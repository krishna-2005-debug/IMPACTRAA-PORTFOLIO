# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/impactra_db?retryWrites=true&w=majority

# Web Server port binding (Render handles this dynamically)
PORT=10000

# JSON Web Token secret key for Admin CMS authentication hashing
JWT_SECRET=super_secret_session_token_key_here

# Allowed origins for HTTP Cross-Origin resource requests
CORS_ORIGIN=http://localhost:5173
